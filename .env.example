# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).
#
# Two kinds of variables live here:
#   1. PUBLIC (NEXT_PUBLIC_*) — safe to expose in the browser.
#   2. SERVER-ONLY SECRETS — read only on the server, never sent to the browser,
#      never logged. Do NOT prefix a secret with NEXT_PUBLIC_.
#
# Do NOT add a Supabase service-role key — the app never uses one.

# --- Public (browser-safe) ---------------------------------------------------

# Public base URL of the site, used for canonical URLs, Open Graph metadata
# and the Supabase email-confirmation redirect. Set to the production domain
# on Vercel (e.g. https://publy.fr).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable key (both public/safe for the browser).
# Find them in the Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Server-only secrets (NEVER exposed to the browser) ----------------------

# Anthropic API key for advertorial generation (Milestone 3A). Server-only:
# it is read from process.env on the server, never inlined into the client
# bundle, never logged. Leave unset locally to keep generation disabled (the UI
# shows a clear "not configured" message). Create one at
# https://console.anthropic.com/. Placeholder only — put the real value in
# .env.local (gitignored) or your host's secret store, never in git.
ANTHROPIC_API_KEY=

# Later milestones (do NOT set yet — the code does not read them):
# - Stripe: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
