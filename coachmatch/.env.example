# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Les clés NEXT_PUBLIC_* sont exposées au
# navigateur (c'est prévu : la sécurité repose sur les policies RLS, voir
# supabase/migrations/0002_rls.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service — UNIQUEMENT côté serveur (scripts d'admin, webhooks). Ne jamais
# la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe Connect (monétisation) ───────────────────────────────────────────
# Le coach encaisse via un compte Connect Express ; la plateforme prélève une
# commission (application_fee_amount). Voir src/lib/stripe.ts.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
